{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tresh",
  "version": "0.1.0",
  "identifier": "com.solcogito.tresh",
  "build": {
    "beforeDevCommand": "npm run dev -- --strictPort",
    "devUrl": "http://127.0.0.1:4326",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tresh",
        "width": 1600,
        "height": 1000,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
